{
    "name": "big-bytes/edlgutl",
    "description": "Edlgütl Website – Contao 5 Managed Edition",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "contao/manager-bundle": "^5.3",
        "contao/calendar-bundle": "^5.3",
        "contao/faq-bundle": "^5.3",
        "contao/news-bundle": "^5.3",
        "contao/newsletter-bundle": "^5.3"
    },
    "require-dev": {},
    "conflict": {
        "contao-components/installer": "<1.3"
    },
    "extra": {
        "contao-component-dir": "assets",
        "symfony": {
            "require": "^7.0"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "contao-components/installer": true,
            "contao/manager-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "contao:install": "symfony-cmd",
            "contao:symlinks": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
